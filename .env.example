# Required: get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Optional overrides
# Not every Groq account has access to the same models. After setting
# GROQ_API_KEY above, run `python list_models.py` to see what your key
# can use, then uncomment and set one below.
# GROQ_MODEL=llama-3.3-70b-versatile
HEADLESS=true
